menu "Ameng companion"

config AMENG_CARD_NAME
    string "Local badge name"
    default "AI PASSPORT"
    help
        Name shown on the local badge page. The factory WeChat badge protocol
        is not part of the public repository, so this custom firmware keeps a
        local badge page instead of pretending to support factory sync.

config AMENG_CARD_BIO
    string "Local badge bio"
    default "阿猛陪伴版"

config AMENG_AI_ENABLE
    bool "Enable optional cloud AI dialogue"
    default n
    help
        Local pet logic always works without AI. When enabled, 对话 may call an
        OpenAI-compatible Chat Completions endpoint. Credentials stay in the
        local sdkconfig; do not commit them.

config AMENG_WIFI_SSID
    string "2.4 GHz Wi-Fi SSID"
    default ""
    depends on AMENG_AI_ENABLE

config AMENG_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    depends on AMENG_AI_ENABLE

config AMENG_AI_ENDPOINT
    string "AI Chat Completions endpoint"
    default "https://api.openai.com/v1/chat/completions"
    depends on AMENG_AI_ENABLE

config AMENG_AI_MODEL
    string "AI model name"
    default "gpt-4o-mini"
    depends on AMENG_AI_ENABLE

config AMENG_AI_API_KEY
    string "AI API key"
    default ""
    depends on AMENG_AI_ENABLE

endmenu
